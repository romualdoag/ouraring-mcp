# Auth: OURARING_* wins (already in ~/.hermes/.env), OURA_* accepted as fallback.
# The auth script loads ./.env first, then ~/.hermes/.env for gaps — so you
# usually need nothing here unless you want repo-local overrides.

# Pick ONE access method. PAT is simplest for single-user use:
# https://cloud.ouraring.com/personal-access-tokens
OURARING_ACCESS_TOKEN=

# ...or OAuth2 app credentials (must match https://cloud.ouraring.com/oauth/applications):
# Already set globally — only copy here to override per-checkout.
# OURARING_CLIENT_ID=
# OURARING_CLIENT_SECRET=
# OURARING_REDIRECT_URI=http://localhost:8080/callback
# After `npm run auth:oura`, it can append:
# OURARING_REFRESH_TOKEN=

# Optional overrides
# OURARING_API_BASE=https://api.ouraring.com
# OURARING_TIMEOUT_MS=30000
